# Copy to .env (git-ignored) and fill in every value: cp .env.example .env
# SQL Server rejects weak passwords: at least 8 characters with upper case, lower case
# and digits. Avoid @ : / % ' in the two service passwords, since they go into a URL.

# Password of the SQL Server admin (sa), used only by the healthcheck and db-init
SA_PASSWORD=

# Password of each service's own database login, created by db/init.sql
PROPERTY_DB_PASSWORD=
TASKS_DB_PASSWORD=

# Signs login tokens; property and tasks must share it. Any long random string:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
